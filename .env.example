# Copy this file to .env, replace the provider placeholders, then run:
# learn-agent-core init-user-config --from-env .env

# Optional during infrastructure testing; required for real Agent answers.
# Default provider: Anthropic via LangChain ChatAnthropic.
LEARN_AGENT_LLM_API_KEY=
# Optional; leave empty to use ChatAnthropic default Anthropic endpoint.
LEARN_AGENT_LLM_BASE_URL=
LEARN_AGENT_MODEL=
# Maximum output budget for one model response. Thinking tokens consume this
# budget too, so reasoning-heavy models need substantially more than 4096.
# LEARN_AGENT_LLM_MAX_TOKENS=49152
# Must match the actual provider/model context window. This setting controls
# Core budgeting and TUI usage display; it cannot expand a provider limit.
# LEARN_AGENT_MODEL_CONTEXT_LIMIT=192000

# Context compression. Token and Turn limits remain the primary triggers.
# Set the character limit to 0 to disable the fallback character trigger.
# The fixed token ceiling is optional. When disabled, Core derives the soft
# threshold from the model input budget and LEARN_AGENT_CONTEXT_SOFT_LIMIT_RATIO.
# LEARN_AGENT_SUMMARY_TRIGGER_TOKEN_LIMIT_ENABLED=false
# LEARN_AGENT_SUMMARY_TRIGGER_TOKEN_LIMIT=90000
# Maximum character length of the rolling Session/Turn context summary.
# LEARN_AGENT_CONTEXT_SUMMARY_MAX_CHARS=16384
# LEARN_AGENT_SUMMARY_TRIGGER_CHAR_LIMIT=0
# LEARN_AGENT_RECENT_TURN_LIMIT=1
# LEARN_AGENT_RECENT_TURN_BUDGET_RATIO=0.5
# LEARN_AGENT_CONTEXT_SAFETY_MARGIN_TOKENS=8192
# LEARN_AGENT_CONTEXT_SOFT_LIMIT_RATIO=0.85

# Reasoning/thinking display policy for CLI/TUI.
# metadata: show only status/character count; raw thinking is not sent to the frontend.
# collapsed: default, send raw thinking to the frontend, but keep it collapsed until Ctrl+T in TUI.
# expanded: send raw thinking and expand it by default in TUI; useful for local debugging.
# hidden: do not send reasoning/thinking events to the frontend.
# LEARN_AGENT_REASONING_DISPLAY=collapsed
# LEARN_AGENT_REASONING_PREVIEW_LIMIT=12000
# Anthropic prompt prefix cache policy. Global switch disables all cache_control injection.
# LEARN_AGENT_PROMPT_CACHE_ENABLED=true
# LEARN_AGENT_PROMPT_CACHE_TTL=5m
# LEARN_AGENT_PROMPT_CACHE_TOOLS=true
# LEARN_AGENT_PROMPT_CACHE_SYSTEM=true
# LEARN_AGENT_PROMPT_CACHE_MESSAGES=true

# Tool authorization and hard capability boundaries.
# manual: pause on ASK and wait for a user decision (default).
# accept_all: automatically record allow_once for ASK; hard DENY boundaries still apply.
# LEARN_AGENT_TOOL_APPROVAL_MODE=manual
# Deprecated compatibility input: true maps to manual; false maps to accept_all.
# LEARN_AGENT_TOOL_APPROVAL_ENABLED=true
# LEARN_AGENT_HOST_EXECUTION_ENABLED=false
# LEARN_AGENT_TOOL_DEFAULT_TIMEOUT_SECONDS=60
# LEARN_AGENT_NETWORK_POLICY=deny
# Structured Workspace writes are Parent-only and pass through tool approval.
# LEARN_AGENT_FILE_WRITE_ENABLED=true
# LEARN_AGENT_FILE_WRITE_MAX_BYTES=1048576
# LEARN_AGENT_FILE_OPERATION_MAX_ENTRIES=100
# Writable commands use isolated staged change sets and are disabled by default.
# LEARN_AGENT_COMMAND_WRITE_ENABLED=false
# LEARN_AGENT_COMMAND_CHANGESET_MAX_FILES=100
# LEARN_AGENT_COMMAND_CHANGESET_MAX_BYTES=10485760
# LEARN_AGENT_HOOKS_ENABLED=true
# Additional hooks.json files separated by ';' on Windows or ':' on Unix.
# LEARN_AGENT_HOOK_CONFIG_FILES=
# Project hooks execute local commands and must be explicitly trusted.
# LEARN_AGENT_PROJECT_HOOKS_ENABLED=false
# Provider-neutral LLM retry policy. SDK-level retries are disabled; Core owns retries.
# LEARN_AGENT_LLM_RETRY_ENABLED=true
# LEARN_AGENT_LLM_FOREGROUND_MAX_ATTEMPTS=3
# LEARN_AGENT_LLM_BACKGROUND_MAX_ATTEMPTS=2
# LEARN_AGENT_LLM_RETRY_BASE_DELAY_SECONDS=1
# LEARN_AGENT_LLM_RETRY_MAX_DELAY_SECONDS=30
# LEARN_AGENT_LLM_RETRY_JITTER_RATIO=0.1

# Deprecated aliases are no longer part of the default Anthropic path.
# Use LEARN_AGENT_LLM_API_KEY and LEARN_AGENT_LLM_BASE_URL instead.

# PostgreSQL settings used by both the host application and compose.yaml
LEARN_AGENT_DB_HOST=127.0.0.1
LEARN_AGENT_DB_PORT=5432
LEARN_AGENT_DB_NAME=learn_agent
LEARN_AGENT_DB_USER=postgres
LEARN_AGENT_DB_PASSWORD=postgres
LEARN_AGENT_DB_CONTAINER=learn-agent-postgres

# Alternatively, provide one connection URL and omit the DB_HOST/PORT/NAME/USER/PASSWORD values.
# LEARN_AGENT_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/learn_agent

# Optional local runtime overrides
# LEARN_AGENT_DEBUG=false
# LEARN_AGENT_CORE_HOST=127.0.0.1
# LEARN_AGENT_CORE_PORT=18765
# LEARN_AGENT_CORE_CONNECT_TIMEOUT_SECONDS=3
# LEARN_AGENT_CORE_SHUTDOWN_TIMEOUT_SECONDS=10
# LEARN_AGENT_DAEMON_STARTUP_TIMEOUT_SECONDS=15
# LEARN_AGENT_DAEMON_STOP_TIMEOUT_SECONDS=15
# LEARN_AGENT_CORE_AGENT_WORKERS=4
# LEARN_AGENT_PG_DUMP_PATH=/path/to/pg_dump
# LEARN_AGENT_STATE_DIR=/path/to/local/state

# Storage backend selectors. SQLite is the only production adapter in this version.
# LEARN_AGENT_CONVERSATION_HISTORY_BACKEND=sqlite
# LEARN_AGENT_MEMORY_BACKEND=sqlite
# LEARN_AGENT_TASK_BACKEND=sqlite
# LEARN_AGENT_CHECKPOINT_BACKEND=sqlite

# LEARN_AGENT_MAX_GRAPH_STEPS_PER_SLICE=20
# LEARN_AGENT_MAX_AUTO_SLICES_PER_GRANT=3
# LEARN_AGENT_MAX_GRANT_WALL_SECONDS=600
# LEARN_AGENT_MAX_PARALLEL_TOOL_CALLS=4
# LEARN_AGENT_MAX_CONTROLLED_EXECUTIONS_PER_GRANT=12
# LEARN_AGENT_MAX_DELEGATIONS_PER_GRANT=6
# LEARN_AGENT_HARD_MAX_TOOL_CALLS_PER_GRANT=100
# Goal-mode private task planning limits
# LEARN_AGENT_TASK_MAX_PER_EXECUTION=40
# LEARN_AGENT_TASK_KEY_MAX_CHARS=64
# LEARN_AGENT_TASK_SUBJECT_MAX_CHARS=160
# LEARN_AGENT_TASK_DESCRIPTION_MAX_CHARS=2000
# LEARN_AGENT_TASK_NOTES_MAX_CHARS=4000
# LEARN_AGENT_TASK_LIST_OUTPUT_LIMIT=8000
# LEARN_AGENT_EVENTS_FILE_ENABLED=true
# LEARN_AGENT_EVENTS_FILE_PATH=/path/to/agent-events.jsonl
# LEARN_AGENT_EVENTS_SQLITE_ENABLED=true
# LEARN_AGENT_EVENTS_SQLITE_PATH=/path/to/events.db
# LEARN_AGENT_EVENTS_SQLITE_RETENTION_DAYS=30
# LEARN_AGENT_EVENTS_ASYNC_WRITE=true
# LEARN_AGENT_EVENTS_BATCH_SIZE=50
# LEARN_AGENT_EVENTS_FLUSH_INTERVAL_SECONDS=1.0
# LEARN_AGENT_EVENTS_QUEUE_MAX_SIZE=1000
# LEARN_AGENT_EVENTS_PAYLOAD_PREVIEW_LIMIT=1000
# LEARN_AGENT_EVENTS_POSTGRES_ENABLED=false

# Cross-layer daemon trace. Records sanitized metadata only.
# LEARN_AGENT_TRACE_ENABLED=true
# LEARN_AGENT_TRACE_DIR=/path/to/traces
# LEARN_AGENT_TRACE_RETENTION_DAYS=14
# LEARN_AGENT_TRACE_BATCH_SIZE=100
# LEARN_AGENT_TRACE_FLUSH_INTERVAL_SECONDS=0.5
# LEARN_AGENT_TRACE_QUEUE_MAX_SIZE=5000
# LEARN_AGENT_TRACE_DATA_PREVIEW_LIMIT=500
# LEARN_AGENT_POSTGRES_PROJECTION_ENABLED=false
# Durable background-maintenance policy
# LEARN_AGENT_MAINTENANCE_POLL_INTERVAL_SECONDS=0.25
# LEARN_AGENT_MAINTENANCE_LEASE_SECONDS=60
# LEARN_AGENT_MAINTENANCE_SHUTDOWN_TIMEOUT_SECONDS=5
# LEARN_AGENT_MAINTENANCE_MAX_ATTEMPTS=5
# LEARN_AGENT_MAINTENANCE_MAX_RETRY_DELAY_SECONDS=300
# LEARN_AGENT_MAINTENANCE_ERROR_PREVIEW_LIMIT=2000

# Durable resource activity API used by every frontend.
LEARN_AGENT_RESOURCE_ACTIVITY_ENABLED=true
LEARN_AGENT_RESOURCE_ACTIVITY_HASH_ENABLED=true
LEARN_AGENT_RESOURCE_ACTIVITY_MAX_ITEMS_PER_EXECUTION=1000
