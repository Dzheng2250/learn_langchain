# ============================================================
# learn-agent 环境变量配置模板
# 复制此文件为 .env 并填入实际值
# ============================================================

# --- LLM 提供商 (必填) ---
# 阿里云百炼 API Key
ALIYUN_API_KEY=sk-your-api-key-here
# 阿里云百炼兼容 OpenAI 的 Base URL
ALIYUN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 模型名称 (可选，默认 deepseek-v4-flash)
# LEARN_AGENT_MODEL=deepseek-v4-flash

# --- 数据库 (可选，默认值适用于 docker-compose 部署) ---
# LEARN_AGENT_DB_HOST=localhost
# LEARN_AGENT_DB_PORT=5432
# LEARN_AGENT_DB_NAME=learn_agent
# LEARN_AGENT_DB_USER=postgres
# LEARN_AGENT_DB_PASSWORD=postgres
# LEARN_AGENT_DB_CONTAINER=learn_agent_pg

# --- 记忆功能 (可选) ---
# LEARN_AGENT_MEMORY_ENABLED=true

# --- 运行时目录 (可选) ---
# LEARN_AGENT_RUNTIME_DIR=
# LEARN_AGENT_ENV_FILE=